    "type": "flarum-extension",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Liufen",
            "email": "792818521@qq.com",
            "homepage": "https://bbs.cathi.cn"
        }
    ],
    "require": {
        "flarum/core": "^2.0.0"
    },
    "autoload": {
        "psr-4": {
